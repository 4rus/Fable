# Copy to .env and fill in real values. Never commit .env.

# Postgres (Supabase, or any Postgres host). Two URLs, both required:
#
# DATABASE_URL — the pooled connection the app uses at runtime. On
# Supabase this is the "Session pooler" / "Transaction pooler" string
# from Project Settings -> Database -> Connect -> ORM -> Prisma
# (port 6543, with ?pgbouncer=true). Supabase's direct db.<ref>.supabase.co
# host is IPv6-only on new projects and unreachable from IPv4-only
# networks — the pooler exists specifically to work around that.
#
# DIRECT_URL — session-mode pooler (port 5432, no pgbouncer flag), used
# only for migrations, which need prepared-statement support the
# transaction-mode pooler doesn't provide.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"

# Symmetric encryption key for values that must be readable in plaintext
# later, not just hashed (currently: 2FA/TOTP secrets — see src/lib/crypto.ts).
# Must decode (base64) to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every previously-encrypted value permanently
# undecryptable — treat it with the same care as NEXTAUTH_SECRET.
ENCRYPTION_KEY="replace-with-a-32-byte-base64-key"

# Transactional email (Resend — https://resend.com). Powers password-reset
# delivery and "send invoice by email". Without RESEND_API_KEY set, both
# features fall back to an honest non-email path (see src/lib/email.ts) —
# they don't pretend to have sent anything.
RESEND_API_KEY=""
# Must be on a domain you've verified in Resend, e.g. "Fable <billing@yourdomain.com>".
# Resend's shared onboarding@resend.dev sender only delivers to the email
# address on your own Resend account — fine for testing, not for real users.
EMAIL_FROM="Fable <onboarding@resend.dev>"

# Receipt/attachment storage (Supabase Storage). Without these set,
# uploads fall back to local disk (src/server/services/storage/localDisk.ts)
# — fine for a single-instance local dev loop, but it does NOT survive a
# redeploy and does not work past one instance. Set both to switch new
# uploads to real object storage (src/server/services/storage/supabaseStorage.ts);
# existing local-disk attachments keep working unchanged (each row records
# which backend it's actually on — see Attachment.provider).
#
# SUPABASE_URL: Project Settings -> API -> Project URL, e.g.
#   https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role secret
#   (NOT the anon/public key — this one bypasses Storage's RLS and must
#   never be exposed to the client; only src/server/services/storage/
#   supabaseStorage.ts ever reads it). The bucket ("attachments", private)
#   is created automatically on first upload if it doesn't already exist.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
