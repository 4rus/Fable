// ─────────────────────────────────────────────────────────────────────────
// FINANCIAL DATA MODEL — read before changing anything in here.
//
// ACCOUNTING MODEL (be honest about what this is):
// This is CASH-BASIS, SINGLE-ENTRY bookkeeping, not GAAP double-entry
// accounting. We track money in (Payments) and money out (Expenses) against
// a manually-entered starting cash balance. We do NOT maintain a chart of
// accounts, debits/credits, or a balance sheet. This is a deliberate scope
// decision (see Product Thesis "NOT BUILDING": full accrual bookkeeping) —
// it is enough to give an owner an honest, explainable cash picture, and it
// is simple enough that nothing here can silently drift out of balance the
// way a fake half-implemented double-entry system could. If we ever need
// accrual accounting or a real balance sheet, that is a deliberate,
// separately-designed migration — do not bolt it on ad hoc.
//
// MONEY: all monetary amounts are stored as INTEGER MINOR UNITS (cents),
// never floats. See src/lib/money.ts — that module is the only place
// money math should happen.
//
// TENANCY: every business-owned row carries `businessId` directly (not
// inferred through a join). Every query MUST filter by a businessId that
// was derived server-side from the authenticated user's membership — never
// from a client-supplied value. See src/server/tenant.ts.
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (transaction mode, 6543) — used by the app at runtime
  directUrl = env("DIRECT_URL") // session mode (5432) — used for migrations, which need prepared-statement support the transaction pooler doesn't provide
}

// ── Identity ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Two-factor auth (TOTP). `twoFactorSecretEncrypted` is set as soon as
  /// setup begins but `twoFactorEnabled` stays false until the user proves
  /// they can actually generate a valid code (see confirmTwoFactorSetup in
  /// src/server/services/twoFactor.ts) -- a secret alone doesn't mean 2FA
  /// is protecting the account yet. Encrypted at rest (src/lib/crypto.ts)
  /// because, unlike a password, we need the plaintext back to compute
  /// HOTP against a submitted code -- hashing isn't an option here.
  twoFactorEnabled         Boolean @default(false)
  twoFactorSecretEncrypted String?

  memberships          Membership[]
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  twoFactorBackupCodes TwoFactorBackupCode[]

  @@map("users")
}

/// Single-use recovery codes for when a user has 2FA enabled but has lost
/// their authenticator device. Hashed with SHA-256 (not bcrypt) -- same
/// reasoning as PasswordResetToken: these are high-entropy generated
/// values, not user-chosen low-entropy secrets, so there's no brute-force
/// concern a slow hash would meaningfully mitigate that a fast one doesn't.
model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

/// Password reset. We store a SHA-256 hash of the token, never the token
/// itself — identical reasoning to why we hash passwords: a DB read alone
/// should never be enough to take over an account. A token is single-use
/// (`usedAt`) and short-lived (`expiresAt`); requesting a new one does not
/// invalidate outstanding ones by row, but resetPassword() invalidates all
/// of the user's outstanding tokens once any one of them succeeds.
///
/// NOTE: no email provider is configured in this environment (see README).
/// The request flow below is real — it creates and validates a genuine,
/// single-use, expiring token — but until an email provider is wired in,
/// the reset link is surfaced directly in the response rather than mailed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// NOTE ON ENUMS: SQLite (our local-dev provider) has no native enum type,
/// and we want dev/prod schemas to stay identical when we point
/// DATABASE_URL at Postgres — so enum-shaped fields below are plain
/// Strings with the allowed values documented in a comment and enforced by
/// the shared TS union types in src/lib/types.ts + Zod schemas at every
/// write path. Never write one of these columns without going through
/// those types.

/// The ONLY table that connects a User to a Business. Every authorization
/// check in the app goes: session.userId -> Membership(status=ACTIVE) -> businessId.
model Membership {
  id         String    @id @default(cuid())
  userId     String
  businessId String
  role       String    @default("OWNER") // "OWNER" | "MEMBER" — see src/lib/types.ts
  status     String    @default("ACTIVE") // "ACTIVE" | "REVOKED"
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

// ── Tenant ──────────────────────────────────────────────────────────────

model Business {
  id       String @id @default(cuid())
  name     String
  timezone String @default("America/New_York")
  currency String @default("USD") // v1 is single-currency by design; see thesis exclusions

  /// Manually-entered starting point for cash calculations until a real
  /// bank feed exists. `startingCashCents` is the known cash balance AS OF
  /// `startingCashAsOf`. Cash position after that date = starting balance
  /// + payments received - expenses incurred, both filtered to > asOf.
  startingCashCents Int      @default(0)
  startingCashAsOf  DateTime @default(now())

  // ── Onboarding (Phase N) ─────────────────────────────────────────────
  // Both nullable, both purely UX state — never read by insights.ts or
  // forecast.ts, which treat startingCashCents=0 as a legitimate real
  // value regardless of whether a human ever confirmed it. See
  // src/server/services/onboarding.ts for how these combine with live
  // data (any bank connection/invoice/expense) into one derived
  // "is onboarding done" status — most of that status needs no stored
  // state at all, these two columns exist only for the two paths that
  // leave no other trace: explicitly skipping the guided setup screen,
  // and explicitly confirming a starting cash balance (including
  // confirming it's genuinely $0, which is indistinguishable from
  // "never touched" without a separate flag).
  onboardingSkippedAt      DateTime?
  startingCashConfirmedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships           Membership[]
  customers             Customer[]
  categories            Category[]
  invoices              Invoice[]
  payments              Payment[]
  expenses              Expense[]
  attachments           Attachment[]
  auditLogs             AuditLog[]
  bankConnections       BankConnection[]
  financialAccounts     FinancialAccount[]
  transactions          Transaction[]
  merchantCategoryRules MerchantCategoryRule[]
  narrations            Narration[]

  @@map("businesses")
}

// ── AI narration layer (Phase J) ────────────────────────────────────────
//
// GROUNDING: this table caches PROSE ONLY — never a number, conclusion, or
// fact the LLM invented itself. Every row's `fields` is a rewrite of text
// that `src/server/services/insights.ts` / `forecast.ts` already computed
// deterministically; `factsHash` pins that rewrite to the exact facts it
// was generated from, so if the underlying numbers change (new invoice,
// new expense, etc.) the cache is invalidated and regenerated rather than
// showing stale narration next to fresh numbers. See
// src/server/services/narration.ts for the generation + validation logic
// (every number in the LLM's output must already appear in its input, or
// the result is thrown away and the caller falls back to the original
// deterministic text).
model Narration {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// What this narration is for, e.g. "insight:overdue-invoices" or
  /// "forecast:90". One cached row per (business, subject).
  subjectKey String

  /// SHA-256 of the canonical JSON of the facts fed to the LLM. A cache
  /// hit requires this to match the facts being narrated right now.
  factsHash String

  /// The rewritten field(s) — shape depends on subjectKey's kind (an
  /// insight has headline/explanation/why; a forecast has a single
  /// summary paragraph). Never trusted as a source of new facts, only
  /// ever rendered as prose alongside the real numbers.
  fields Json

  model       String   @default("")
  generatedAt DateTime @default(now())

  @@unique([businessId, subjectKey])
  @@index([businessId])
  @@map("narrations")
}

// ── Bank connectivity (Phase E) ─────────────────────────────────────────
//
// PROVIDER ABSTRACTION: this domain (BankConnection / FinancialAccount /
// Transaction) must never leak into the rest of the app as "Plaid
// concepts." Every model below has a `provider` field and stores
// provider-native IDs, but the shapes themselves (a connection, an
// account, a transaction) are provider-agnostic — another provider
// (Flinks, etc.) could be added later by writing a new adapter that
// produces these same shapes, without changing any model or any code
// outside src/server/services/bank/. Only the adapter
// (src/server/services/bank/plaidClient.ts today) is allowed to import
// the `plaid` package or reference Plaid-specific types.
//
// SECURITY: `accessTokenEncrypted` is the credential that lets Fable read
// an account's transactions — encrypted at rest (src/lib/crypto.ts,
// same AES-256-GCM primitive 2FA secrets use), NEVER sent to the client,
// and only ever decrypted server-side, inside the adapter, for the
// duration of a single provider API call.

/// One connected bank/institution. A business can have several.
model BankConnection {
  id         String @id @default(cuid())
  businessId String
  provider   String @default("plaid") // only "plaid" exists today; the column exists so a future provider doesn't need a migration

  providerItemId       String @unique // Plaid's item_id — stable identity for this connection at the provider
  accessTokenEncrypted String // NEVER exposed to the client; server-only; see src/lib/crypto.ts

  institutionId   String?
  institutionName String?

  /// ACTIVE: syncing normally. ERROR: provider reports a problem (e.g.
  /// expired consent, revoked access) — surfaced to the user with
  /// errorCode, they need to reconnect. REVOKED: the user disconnected it
  /// in Fable; kept (not deleted) so historical transactions/audit trail
  /// survive a disconnect.
  status    String  @default("ACTIVE")
  errorCode String?

  lastSyncedAt       DateTime?
  transactionsCursor String? // Plaid's /transactions/sync cursor — enables incremental sync (Phase F); null means "never synced"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accounts FinancialAccount[]

  @@index([businessId])
  @@map("bank_connections")
}

/// One account (checking, savings, credit card, ...) under a BankConnection.
model FinancialAccount {
  id               String @id @default(cuid())
  businessId       String
  bankConnectionId String

  providerAccountId String @unique // Plaid's account_id

  name    String
  mask    String? // last 4 digits, for display ("Checking ...4321")
  type    String // provider-native type ("depository", "credit", ...) — not a Fable enum, this is observed data
  subtype String?

  currentBalanceCents   Int?
  availableBalanceCents Int?
  isoCurrencyCode       String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bankConnection BankConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([businessId])
  @@index([bankConnectionId])
  @@map("financial_accounts")
}

/// A synced bank transaction. Distinct from `Expense`/`Payment` (which
/// are the business's OWN manually-entered or CSV-imported records) —
/// Transaction is what the bank actually reports happened. Phase G
/// (transaction intelligence) is what will eventually reconcile the two;
/// this model does not auto-create Expense/Payment rows on its own.
model Transaction {
  id                 String @id @default(cuid())
  businessId         String
  financialAccountId String

  /// Plaid's transaction_id — the stable identity that makes sync
  /// idempotent. A sync that sees this ID again updates the existing row
  /// (e.g. pending -> posted); it never inserts a duplicate.
  providerTransactionId String @unique

  /// Plaid's sign convention, kept as-is rather than flipped: POSITIVE =
  /// money OUT (a purchase/debit), NEGATIVE = money IN (a
  /// deposit/credit). Documented here because it's the opposite of how
  /// Expense.amountCents (always positive) reads.
  amountCents     Int
  isoCurrencyCode String @default("USD")

  postedDate     DateTime
  authorizedDate DateTime?

  merchantName String?
  description  String // Plaid's raw "name" field

  pending Boolean @default(false)

  /// Fable's own category assignment (Phase G) — null until categorized.
  /// Set ONLY in two ways: (1) a high-confidence match against this
  /// business's own MerchantCategoryRule (categorySource="merchant_rule"),
  /// applied automatically at sync time, or (2) the user picking a
  /// category by hand (categorySource="manual"). A generic keyword-based
  /// guess is NEVER written here — it's surfaced as a live suggestion in
  /// the review UI and only becomes real once the user confirms it (at
  /// which point it's a "manual" pick and gets learned as a rule). Never
  /// set from providerCategory automatically.
  categoryId       String?
  categorySource   String? // "merchant_rule" | "manual" — how categoryId got set; null iff categoryId is null
  providerCategory String? // Plaid's raw category, kept for reference only — never authoritative

  /// User explicitly said "not a business expense" / "this is a transfer,
  /// not real income or spend" — excluded from the review queue and never
  /// reconciled into an Expense/Payment. Distinct from deletedAt (which
  /// means the bank itself retracted the transaction).
  ignoredAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft-delete: Plaid can report a previously-synced (e.g. pending)
  /// transaction as removed. Historical/audit integrity matters more
  /// here than a clean list, so this is marked, not hard-deleted.
  deletedAt DateTime?

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  category         Category?        @relation(fields: [categoryId], references: [id])

  /// Back-relations for the reconciliation link — the FK actually lives on
  /// Expense.transactionId / Payment.transactionId (each @unique), which is
  /// what makes "reconcile the same transaction twice" a DB-level
  /// impossibility rather than an application-level promise.
  expense Expense?
  payment Payment?

  @@index([businessId, postedDate])
  @@index([financialAccountId])
  @@index([categoryId])
  @@map("transactions")
}

/// A learned merchant -> category mapping, scoped to one business. Created
/// the moment a user categorizes a Transaction (by hand, or by confirming
/// a suggested category) — see setTransactionCategory() in
/// src/server/services/bank/categorization.ts. This is the ONLY thing that
/// counts as "high confidence" for auto-categorization at sync time; a
/// generic keyword match never writes one of these and never
/// auto-applies. `merchantKey` is a normalized (lowercased, de-noised)
/// form of the transaction's merchant name/description, not the raw
/// string — see normalizeMerchantKey().
model MerchantCategoryRule {
  id          String @id @default(cuid())
  businessId  String
  merchantKey String
  categoryId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([businessId, merchantKey])
  @@index([businessId])
  @@index([categoryId])
  @@map("merchant_category_rules")
}

// ── Customers / Revenue side ───────────────────────────────────────────

model Customer {
  id         String    @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([businessId])
  @@map("customers")
}

/// `status` ("DRAFT" | "SENT" | "PARTIALLY_PAID" | "PAID" | "VOID" — see
/// src/lib/types.ts) is a CACHE recomputed server-side inside a transaction
/// every time a payment is recorded/removed (see
/// src/server/services/invoices.ts). It must never be trusted as
/// authoritative on its own — the sum of non-voided Payments against
/// `totalCents` is the source of truth. "Overdue" is intentionally NOT a
/// stored status: it's derived at read time from (dueDate < now && status
/// in SENT/PARTIALLY_PAID) so it can never go stale.
model Invoice {
  id            String    @id @default(cuid())
  businessId    String
  customerId    String
  number        String
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  status        String    @default("DRAFT")
  subtotalCents Int
  taxCents      Int       @default(0)
  totalCents    Int
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  /// When a payment-reminder email last went out for this invoice (Phase
  /// K — see src/server/services/reminderEmail.ts). Distinct from
  /// anything invoice-email-related: sending the invoice itself doesn't
  /// touch this. Used only to rate-limit accidental repeat sends (a
  /// double-click, an eager owner) — never to change status or any
  /// financial fact.
  lastReminderSentAt DateTime?

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer          @relation(fields: [customerId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, dueDate])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int    @default(1)
  unitPriceCents Int
  amountCents    Int // quantity * unitPriceCents, computed server-side, never trusted from client

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A payment received against an invoice. Partial payments are a first-
/// class case: an invoice can have many payments whose sum is <= totalCents
/// (enforced in the service layer inside a DB transaction, not just in UI).
model Payment {
  id          String    @id @default(cuid())
  businessId  String
  invoiceId   String
  amountCents Int
  method      String    @default("other") // "cash" | "check" | "card" | "bank_transfer" | "other"
  paidAt      DateTime  @default(now())
  note        String?
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?

  /// Prevents a duplicated network retry from recording the same payment
  /// twice. Caller (client or import job) generates this once per logical
  /// payment attempt.
  idempotencyKey String? @unique

  /// Set when this Payment was created by confirming a matched bank
  /// Transaction (Phase G), rather than entered by hand. @unique makes
  /// "reconcile the same deposit twice" a constraint violation, not just an
  /// application-level promise — see confirmInvoicePayment() in
  /// src/server/services/bank/reconciliation.ts.
  transactionId String? @unique

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([businessId])
  @@index([invoiceId])
  @@map("payments")
}

// ── Expenses / Cash-out side ───────────────────────────────────────────

model Category {
  id         String   @id @default(cuid())
  businessId String
  name       String
  type       String // "INCOME" | "EXPENSE" — see src/lib/types.ts
  isSystem   Boolean  @default(false) // seeded default categories vs. user-created
  createdAt  DateTime @default(now())

  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses      Expense[]
  transactions  Transaction[]
  merchantRules MerchantCategoryRule[]

  @@unique([businessId, name, type])
  @@map("categories")
}

model Expense {
  id          String    @id @default(cuid())
  businessId  String
  categoryId  String
  vendorName  String
  amountCents Int
  incurredAt  DateTime  @default(now())
  description String?
  isRecurring Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  /// Set when this Expense was created by confirming a synced bank
  /// Transaction (Phase G), rather than entered by hand or via CSV import.
  /// @unique makes "reconcile the same transaction twice" a constraint
  /// violation, not just an application-level promise — see
  /// confirmExpenseFromTransaction() in
  /// src/server/services/bank/reconciliation.ts.
  transactionId String? @unique

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  attachments Attachment[]
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([businessId, incurredAt])
  @@index([categoryId])
  @@map("expenses")
}

/// A receipt/document attached to an expense. `storageKey` is an opaque
/// path into the storage backend (local disk in dev — see
/// src/server/services/attachments.ts — object storage in production) and
/// is NEVER exposed directly to a client; every download goes through
/// /api/attachments/[id], which re-checks tenant membership before
/// streaming a single byte. Never a public/guessable URL.
model Attachment {
  id               String   @id @default(cuid())
  businessId       String
  expenseId        String
  filename         String // original filename, sanitized before display — never used to build a filesystem path
  storageKey       String   @unique
  /// Which storage backend actually holds the bytes at `storageKey` — see
  /// src/server/services/storage/. Recorded PER ROW (not read from
  /// current config) so switching the app's active backend (e.g. local
  /// disk in dev -> Supabase Storage once configured) never breaks
  /// reading/deleting a file that was uploaded under the old one. Same
  /// reasoning as BankConnection.provider.
  provider         String   @default("local") // "local" | "supabase"
  mimeType         String // sniffed from real file content, not the client's claimed Content-Type
  sizeBytes        Int
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expense  Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([expenseId])
  @@map("attachments")
}

// ── Audit trail ─────────────────────────────────────────────────────────

/// Append-only. Never update or delete rows in this table from application
/// code. If a mutation matters for money or access, it gets logged here.
model AuditLog {
  id         String   @id @default(cuid())
  businessId String?
  userId     String?
  action     String // e.g. "invoice.create", "payment.record", "membership.revoke"
  entityType String
  entityId   String
  metadata   String? // JSON-encoded, non-sensitive context only
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
